verilog
// =====================================================================
// CCSA Variant B - sequential multi-cycle RTL
// W-bit parameterised adder, 4-step algorithm.
// Matches Section 7.3.1 of the manuscript exactly.
// =====================================================================
`timescale 1ns/1ps
`default_nettype none

module ccsa #(
    parameter integer W = 8
) (
    input  wire                clk,
    input  wire                rst_n,
    input  wire                start,
    input  wire [W-1:0]        A,
    input  wire [W-1:0]        B,
    output reg  [W-1:0]        S,
    output reg                 done
);

    // -----------------------------------------------------------------
    // Registers U, L, M (Section 7.2)
    // -----------------------------------------------------------------
    reg [W-1:0] U, L, M;
    reg [1:0]   step;      // 0=idle, 1..4 = current step

    // -----------------------------------------------------------------
    // Virtual-boundary helpers (combinational)
    // -----------------------------------------------------------------
    wire [W:0] U_ext = {1'b0, U};      // U_ext[l] = U[l-1]; U_ext[0]=0
    wire [W:0] L_ext = {1'b0, L};
    wire [W:0] M_ext = {1'b0, M};
    // U[l+1] access: shift the other way
    wire [W:0] U_hi  = {U, 1'b0};      // U_hi[l] = U[l+1]; U_hi[W-1]=0

    // -----------------------------------------------------------------
    // Step 1 combinational
    // -----------------------------------------------------------------
    wire [W-1:0] U1_c = A ^ B;
    wire [W-1:0] L1_c = A & B;

    // -----------------------------------------------------------------
    // Step 2 combinational
    // -----------------------------------------------------------------
    wire [W-1:0] R_c, Lam_c, B2_c, E_c, U2_c, L2_c, M_c;

    assign R_c   = U1_c & ~U_ext[W-1:0] & ~L_ext[W-1:0];
    assign Lam_c = ~U1_c & U_ext[W-1:0];

    // B2 is a left-to-right ripple; use a small generate loop
    genvar i;
    generate
        for (i = 0; i < W; i = i + 1) begin : g_bus2
            if (i == 0) begin : g_first
                assign B2_c[i] = R_c[i];
            end else begin : g_rest
                assign B2_c[i] = R_c[i] | (B2_c[i-1] & ~Lam_c[i]);
            end
        end
    endgenerate

    assign E_c  = B2_c & U1_c;
    assign U2_c = U1_c & ~E_c;
    assign L2_c = L1_c | E_c;
    assign M_c  = E_c;

    // -----------------------------------------------------------------
    // Step 3 combinational (uses registered U, L, M from Step 2)
    // -----------------------------------------------------------------
    wire [W-1:0] U3_c, L3_c;

    assign U3_c = (~U & U_ext[W-1:0])
                | (~M_ext[W-1:0] & L_ext[W-1:0]
                   & ~U_ext[W-1:0] & ~U);
    assign L3_c = L & M;

    // -----------------------------------------------------------------
    // Step 4 combinational
    // -----------------------------------------------------------------
    wire [W-1:0] U4_c = U3_c | L3_c;
    wire [W-1:0] L4_c = {W{1'b0}};

    // -----------------------------------------------------------------
    // Sequential control
    // -----------------------------------------------------------------
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            U    <= {W{1'b0}};
            L    <= {W{1'b0}};
            M    <= {W{1'b0}};
            S    <= {W{1'b0}};
            step <= 2'd0;
            done <= 1'b0;
        end else begin
            done <= 1'b0;
            case (step)
                2'd0: begin
                    if (start) begin
                        U    <= U1_c;
                        L    <= L1_c;
                        M    <= {W{1'b0}};
                        step <= 2'd1;
                    end
                end
                2'd1: begin
                    U    <= U2_c;
                    L    <= L2_c;
                    M    <= M_c;
                    step <= 2'd2;
                end
                2'd2: begin
                    U    <= U3_c;
                    L    <= L3_c;
                    M    <= {W{1'b0}};
                    step <= 2'd3;
                end
                2'd3: begin
                    U    <= U4_c;
                    L    <= L4_c;
                    S    <= U4_c;
                    step <= 2'd0;
                    done <= 1'b1;
                end
                default: step <= 2'd0;
            endcase
        end
    end

endmodule

`default_nettype wire
