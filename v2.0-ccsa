# 1. Enter the repository root
cd ~/A-Carry-Chain-Separation

# 2. Confirm you are on the branch that contains all your latest work
git status
git log --oneline -3

# 3. Stage any remaining uncommitted changes
git add -A

# 4. Commit them
git commit -m "v2.0-ccsa: reproducible release matching Manuscript_18.09"

# 5. Create the annotated tag on the current commit
git tag -a v2.0-ccsa -m "Reproducible release matching Manuscript_18.09 (tag v2.0-ccsa)"

# 6. Push the branch and the tag to GitHub
git push origin main
git push origin v2.0-ccsa

# 7. Verify the tag exists on the remote
git ls-remote --tags origin | grep v2.0-ccsa
