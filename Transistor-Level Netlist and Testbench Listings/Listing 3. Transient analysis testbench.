* ==============================================================
* Transient Analysis Testbench
* Segment delay, discharge time, charge-sharing droop
* ==============================================================
.INCLUDE "asap7_models.sp"
.INCLUDE "ccsa_segment_k16.sp"

VDD vdd 0 0.70
VSS vss 0 0
Vbus1 bus1 0 0.70

* Same switch control vectors as Listing 2 (selected configuration)
* ... (repeated for brevity; full listing in Supp.E)

* Unselected island n8 discharged to LOW via per-bit pull-downs
.IC V(n8)=0.0

XSEG bus1 bus2_in bus2_out vdd vss CCSA_SEGMENT_K16

.TRAN 1p 200n UIC
.PRINT TRAN V(bus2_out) V(n0) V(n8) V(E15) I(VDD)

.MEASURE TRAN t_seg TRIG V(bus2_in) VAL=0.35 RISE=1
+                 TARG V(bus2_out) VAL=0.35 RISE=1
.MEASURE TRAN t_rise TRIG V(bus2_out) VAL=0.07 RISE=1
+                 TARG V(bus2_out) VAL=0.63 RISE=1
.MEASURE TRAN t_dis TRIG V(bus2_out) VAL=0.63 FALL=1
+                 TARG V(bus2_out) VAL=0.35 FALL=1
.END
